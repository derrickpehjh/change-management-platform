# Copy this file to .env and fill in the values marked REQUIRED.
# Defaults are set for local development — change for production.

# REQUIRED — generate with: openssl rand -base64 32
JWT_SECRET=

# REQUIRED for production — the URL your browser uses to reach the web app
# Local default works for docker compose on localhost
WEB_ORIGIN=http://localhost:3001

# Postgres password (default: cmp)
POSTGRES_PASSWORD=cmp

# MinIO credentials (default: minioadmin)
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Public MinIO URL used to generate presigned download URLs.
# Must be reachable from the browser — change if running on a remote host.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Auth mode: mock (no OAuth, any password works) or gitlab
AUTH_MODE=mock
