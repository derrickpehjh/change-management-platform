NEXT_PUBLIC_API_URL="http://localhost:4000"
# "true" on hosted demo/POC deployments with no durable file storage — shows the
# attachment upload UI but doesn't actually send files to the API.
NEXT_PUBLIC_DEMO_MODE="false"

# Only needed on a deployment where the frontend and API are on different
# domains (e.g. Vercel + Railway). Set NEXT_PUBLIC_API_URL="/api" and this to
# the API's real origin — next.config.js proxies /api/* to it server-side, so
# the browser only ever talks to this app's own domain and the session
# cookie is same-site instead of a genuine third-party cookie (which Safari
# and increasingly Chrome block outright). Leave both unset for local dev.
# API_PROXY_ORIGIN="https://your-api.example.com"
