# Postgres
DATABASE_URL="postgresql://cmp:cmp@localhost:5432/cmp?schema=public"

# App
PORT=4000
WEB_ORIGIN="http://localhost:3000"
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="12h"
COOKIE_NAME="cmp_session"
# Set to "true" only when the frontend and API are on different domains (e.g.
# a Vercel + Railway deployment) — switches the session cookie to
# SameSite=None; Secure, which is what cross-site fetch requires. Leave unset
# for local dev (frontend/API share "localhost", just different ports).
COOKIE_CROSS_SITE="false"

# Auth mode: "mock" (dummy login picker, default) or "gitlab" (real self-hosted GitLab OIDC SSO)
AUTH_MODE="mock"

# Only required when AUTH_MODE=gitlab. Register an OAuth application on your
# self-hosted GitLab instance (User Settings > Applications, or an instance-wide
# Application) with scopes "openid email profile" and this callback URL:
#   {API origin}/auth/gitlab/callback
GITLAB_ISSUER_URL="https://gitlab.your-htx-instance.example"
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""
GITLAB_CALLBACK_URL="http://localhost:4000/auth/gitlab/callback"
