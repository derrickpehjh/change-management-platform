# Copy this file to .env and fill in the values marked REQUIRED.
# Defaults are set for local development — change for production.

# REQUIRED — generate with: openssl rand -base64 32
JWT_SECRET=

# REQUIRED for production — the URL your browser uses to reach the web app
# Local default works for docker compose on localhost
WEB_ORIGIN=http://localhost:3001

# Postgres password (default: cmp)
POSTGRES_PASSWORD=cmp

# MinIO credentials (default: minioadmin)
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Public MinIO URL used to generate presigned download URLs.
# Must be reachable from the browser — change if running on a remote host.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Auth mode: mock (no OAuth, any password works) or gitlab
AUTH_MODE=mock

# Set to false ONLY when serving over plain http:// on a non-localhost host
# (e.g. a staging server at http://<server-ip>:3001) — otherwise login
# silently fails because browsers drop Secure cookies over http.
# COOKIE_SECURE=false

# Optional tuning — safe defaults are shown
# JWT_EXPIRES_IN=12h
# COOKIE_NAME=cmp_session
# COOKIE_CROSS_SITE=false   # set to true when API and web are on different domains
# S3_REGION=us-east-1       # ignored by MinIO but required for AWS S3

# GitLab SSO — only required when AUTH_MODE=gitlab
# Register an OAuth app in GitLab: Settings → Applications
# Scopes: openid email profile
# Callback URL: http://<your-api-host>:4000/auth/gitlab/callback
GITLAB_ISSUER_URL=https://gitlab.example.com
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_CALLBACK_URL=http://localhost:4000/auth/gitlab/callback
