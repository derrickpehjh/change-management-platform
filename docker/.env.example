# Copy this to docker/.env and fill in before running docker compose.
# Values here override the defaults baked into docker-compose.yml.

# --- API ---
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"
COOKIE_NAME="cmp_session"
# Set to "true" if frontend and API are on different domains
COOKIE_CROSS_SITE="false"

# Auth mode: "mock" (default) or "gitlab"
AUTH_MODE="mock"

# Only required when AUTH_MODE=gitlab
GITLAB_ISSUER_URL=""
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""
GITLAB_CALLBACK_URL="http://localhost:4000/auth/gitlab/callback"

# File upload directory inside the api container
UPLOADS_DIR="./uploads"

# --- Web ---
NEXT_PUBLIC_DEMO_MODE="false"
