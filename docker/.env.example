# Copy this to docker/.env and fill in before running docker compose.
# Values here override the defaults baked into docker-compose.yml.

# --- API ---
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"
COOKIE_NAME="cmp_session"
# Set to "true" if frontend and API are on different domains
COOKIE_CROSS_SITE="false"
# Must match the port the web container is exposed on
WEB_ORIGIN="http://localhost:3001"

# Auth mode: "mock" (default) or "gitlab"
AUTH_MODE="mock"

# Only required when AUTH_MODE=gitlab
GITLAB_ISSUER_URL=""
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""
GITLAB_CALLBACK_URL="http://localhost:4000/auth/gitlab/callback"

# --- S3 / MinIO (file attachments) ---
# S3_ENDPOINT and credentials are baked into docker-compose.yml for local dev.
# Override here for a real S3 bucket or external MinIO in production.
# S3_ENDPOINT="https://your-minio.example.com"
# S3_PUBLIC_ENDPOINT="https://your-minio.example.com"  # browser-accessible URL
# S3_BUCKET="attachments"
# S3_ACCESS_KEY_ID="your-access-key"
# S3_SECRET_ACCESS_KEY="your-secret-key"
# S3_REGION="us-east-1"

# --- Web ---
NEXT_PUBLIC_DEMO_MODE="false"
